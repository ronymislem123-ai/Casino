{
  "name": "omega-blackjack-infinity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Blackjack strategy engine, exact EV calculator, Monte Carlo simulation lab and live decision assistant (PWA).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "report": "tsx scripts/report.ts",
    "validate:wizard": "tsx scripts/validateWizard.ts",
    "precompute": "tsx scripts/precompute.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/node": "22.10.2",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "3.2.4"
  }
}
